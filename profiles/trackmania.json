    "smoothing": 0.2,
    "filter_type": "NONE",
    "dead_zone": 0.02,
    "max_angle": 45.0,
    "curve": "LINEAR",
    "center_spring": false
  },
  "gestures": {
    "enabled": true,
    "auto_accel": true,
    "brake_source": "FIST"
  }
}