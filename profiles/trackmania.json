{
  "name": "Trackmania (Instant Digital / Arcade)",
  "input_mode": "KEYBOARD",
  "keyboard_mappings": {
    "steer_left": "left",
    "steer_right": "right",
    "accelerate": "up",
    "brake": "down",
    "nitro": "shift",
    "handbrake": "space"
  },
  "steering": {
    "mode": "TWO_HAND",
