{
  "name": "Assetto Corsa (Sim Racing Wheel)",
  "input_mode": "GAMEPAD",
  "gamepad_mappings": {
    "steering_axis": "LX",
    "throttle_axis": "RT",
    "brake_axis": "LT",
    "handbrake_button": "A",
    "nitro_button": "X"
  },
  "steering": {
    "mode": "TWO_HAND",
    "sensitivity": 1.0,
    "smoothing": 0.6,
    "filter_type": "KALMAN",
    "kalman_process_noise": 0.04,
    "kalman_measurement_noise": 0.35,
    "dead_zone": 0.01,
    "max_angle": 180.0,
    "curve": "LINEAR",
    "center_spring": true,
    "center_spring_strength": 0.2
  },
  "gestures": {
    "enabled": true,
    "throttle_source": "THUMBS_UP",
    "brake_source": "FIST"
  }
}