{
  "name": "BeamNG.drive (High Precision Physics)",
  "input_mode": "GAMEPAD",
  "gamepad_mappings": {
    "steering_axis": "LX",
    "throttle_axis": "RT",
    "brake_axis": "LT",
    "handbrake_button": "A",
    "nitro_button": "X"
  },
  "steering": {
    "mode": "TWO_HAND",
