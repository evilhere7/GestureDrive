    "dead_zone": 0.02,
    "max_angle": 120.0,
    "curve": "LINEAR",
    "center_spring": true,
    "center_spring_strength": 0.15
  },
  "gestures": {
    "enabled": true,
    "throttle_source": "THUMBS_UP",
    "brake_source": "FIST",
    "handbrake_gesture": "TWO_FISTS"
  }
}